# Copy to .env for local development. Never commit .env.
MMP_ENVIRONMENT=dev
MMP_LOG_LEVEL=debug
MMP_LOG_JSON=false

MMP_DATABASE_URL=postgresql+asyncpg://USER@127.0.0.1:5432/mmp_dev
MMP_REDIS_URL=redis://127.0.0.1:6379/0

# Dev-only peppers. In staging and prod these are resolved from KMS at boot and
# never written to a file. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
MMP_API_KEY_PEPPER=
MMP_IP_HASH_PEPPER=
MMP_SESSION_SECRET=
